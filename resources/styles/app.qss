
QWidget {
    color: #1F2933;
    font-family: "Segoe UI", "Inter", Arial, sans-serif;
    font-size: 10pt;
}
QMainWindow, QDialog {
    background: #F4F5F7;
}
QFrame#Panel, QWidget#Panel {
    background: #FFFFFF;
    border: 1px solid #DCE0E6;
    border-radius: 10px;
}
QWidget#Sidebar {
    background: #FFFFFF;
    border-right: 1px solid #DCE0E6;
}
QListWidget#Sidebar {
    border: none;
    background: #FFFFFF;
    padding-top: 10px;
}
QListWidget#Sidebar::item {
    padding: 11px 14px;
    border-radius: 6px;
    margin: 2px 8px;
}
QListWidget#Sidebar::item:selected {
    background: #E8F0FE;
    color: #1D4ED8;
    font-weight: 600;
}
QWidget#LayoutToolbar {
    background: #FFFFFF;
    border-bottom: 1px solid #DCE0E6;
}
QWidget#RulerCorner {
    background: #FBFCFD;
    border: 1px solid #DCE0E6;
}
QScrollArea#PreviewScroll {
    background: #DDE0E5;
    border: 1px solid #C6CAD2;
    border-radius: 6px;
}
QLabel#PreviewPage {
    background: #FFFFFF;
    color: #6B7280;
    border: 1px solid #C6CAD2;
}
QLabel#Title {
    font-size: 17pt;
    font-weight: 600;
    color: #1F2933;
}
QLabel#Subtitle {
    font-size: 9pt;
    color: #667085;
}
QLabel#SectionTitle {
    font-size: 10pt;
    font-weight: 600;
    color: #1F2933;
}
QLabel#Metric {
    font-size: 22pt;
    font-weight: 600;
    color: #2563EB;
}
QLabel#Muted {
    color: #667085;
}
QToolBar {
    background: #FFFFFF;
    border-bottom: 1px solid #DCE0E6;
    spacing: 4px;
    padding: 3px 6px;
}
/* Instant-popup tool buttons draw their menu indicator inside the button;
   without reserved space the arrow covered the last character ("Arrange_"). */
QToolButton#MenuToolButton {
    padding: 5px 20px 5px 9px;
}
QToolBar QToolButton {
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 9px;
    color: #1F2933;
}
QToolBar QToolButton:hover {
    background: #E8F0FE;
    border-color: #DCE0E6;
}
QToolBar QToolButton:checked {
    background: #E8F0FE;
    border-color: #2563EB;
}
QPushButton {
    background: #FFFFFF;
    border: 1px solid #C3C9D2;
    border-radius: 7px;
    padding: 6px 14px;
    min-height: 18px;
}
QPushButton:hover {
    border-color: #2563EB;
    color: #1D4ED8;
}
QPushButton:pressed {
    background: #E8F0FE;
}
QPushButton:disabled {
    color: #9AA3AF;
    border-color: #DCE0E6;
    background: #FAFBFC;
}
QPushButton#Primary {
    background: #2563EB;
    border: 1px solid #2563EB;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#Primary:hover {
    background: #1D4ED8;
    border-color: #1D4ED8;
    color: #FFFFFF;
}
QPushButton#Danger {
    color: #B42318;
    border-color: #F3C0BB;
}
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #FFFFFF;
    border: 1px solid #C3C9D2;
    border-radius: 6px;
    padding: 5px 7px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #2563EB;
}
QComboBox::drop-down {
    width: 18px;
    border: none;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #C3C9D2;
    selection-background-color: #E8F0FE;
    selection-color: #1F2933;
    outline: none;
}
QListWidget, QTreeWidget, QTableWidget, QTableView {
    background: #FFFFFF;
    border: 1px solid #DCE0E6;
    border-radius: 8px;
    alternate-background-color: #FAFBFC;
    gridline-color: #EDEFF3;
    selection-background-color: #E8F0FE;
    selection-color: #1F2933;
    outline: none;
}
QListWidget::item, QTreeWidget::item, QTableWidget::item {
    padding: 4px 6px;
}
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background: #E8F0FE;
    color: #1F2933;
}
QHeaderView::section {
    background: #F7F8FA;
    color: #667085;
    border: none;
    border-bottom: 1px solid #DCE0E6;
    border-right: 1px solid #EDEFF3;
    padding: 6px;
    font-weight: 600;
}
QTabWidget::pane {
    border: 1px solid #DCE0E6;
    border-radius: 8px;
    background: #FFFFFF;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    border: 1px solid transparent;
    padding: 7px 14px;
    margin-right: 2px;
    color: #667085;
}
QTabBar::tab:selected {
    color: #2563EB;
    border-bottom: 2px solid #2563EB;
    background: #FFFFFF;
}
QTabBar::tab:hover {
    color: #1F2933;
}
QStatusBar {
    background: #FFFFFF;
    border-top: 1px solid #DCE0E6;
    color: #667085;
}
QStatusBar QLabel {
    color: #667085;
    padding: 0 8px;
}
QSplitter::handle {
    background: #DCE0E6;
}
QSplitter::handle:horizontal {
    width: 3px;
}
QSplitter::handle:vertical {
    height: 3px;
}
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #C6CCD6;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #A8B0BD;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #C6CCD6;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0; width: 0;
}
QProgressBar {
    background: #EDEFF3;
    border: none;
    border-radius: 5px;
    text-align: center;
    height: 8px;
    color: transparent;
}
QProgressBar::chunk {
    background: #2563EB;
    border-radius: 5px;
}
QMenuBar {
    background: #FFFFFF;
    border-bottom: 1px solid #DCE0E6;
}
QMenuBar::item {
    padding: 6px 10px;
    background: transparent;
}
QMenuBar::item:selected {
    background: #E8F0FE;
    border-radius: 5px;
}
QMenu {
    background: #FFFFFF;
    border: 1px solid #C3C9D2;
    border-radius: 8px;
    padding: 5px;
}
QMenu::item {
    padding: 6px 26px 6px 22px;
    border-radius: 5px;
}
QMenu::item:selected {
    background: #E8F0FE;
    color: #1F2933;
}
QMenu::separator {
    height: 1px;
    background: #DCE0E6;
    margin: 4px 8px;
}
QMenu::item:disabled {
    color: #9AA3AF;
}
QMenuBar::item:disabled {
    color: #9AA3AF;
}
QToolBar QToolButton:disabled {
    color: #9AA3AF;
}
QGroupBox {
    border: 1px solid #DCE0E6;
    border-radius: 8px;
    margin-top: 14px;
    padding: 10px 8px 8px 8px;
    background: #FFFFFF;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #667085;
}
QCheckBox, QRadioButton {
    spacing: 7px;
}
QToolTip {
    background: #1F2933;
    color: #FFFFFF;
    border: 1px solid #0B1220;
    padding: 5px 7px;
    border-radius: 5px;
}
QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background: #F7F8FA;
    padding: 6px;
    border-bottom: 1px solid #DCE0E6;
}
